{
  "manifest_version": 3,
  "name": "DeepSeek Web Token Bridge",
  "version": "2.0.0",
  "description": "Sends the chat.deepseek.com session token to omp through native messaging.",
  "permissions": ["nativeMessaging"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
