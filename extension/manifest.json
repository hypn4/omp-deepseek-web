{
  "manifest_version": 3,
  "name": "DeepSeek Web Token Bridge",
  "version": "2.3.0",
  "description": "Sends the chat.deepseek.com session token to omp through native messaging.",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "activeTab"],
  "icons": {
    "16": "icons/deepseek-web-16.png",
    "32": "icons/deepseek-web-32.png",
    "48": "icons/deepseek-web-48.png",
    "128": "icons/deepseek-web-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DeepSeek Token Bridge",
    "default_icon": {
      "16": "icons/deepseek-web-16.png",
      "32": "icons/deepseek-web-32.png",
      "48": "icons/deepseek-web-48.png",
      "128": "icons/deepseek-web-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
